# === CLIENT (safe to expose in browser) ===
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# === SERVER ONLY (never prefix with VITE_) ===
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === GOOGLE GEMINI AI (Free on Google AI Studio) ===
# Optional env fallback - You can also configure keys inside the Admin Portal
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# === SEO & GOOGLE VERIFICATION ===
VITE_SITE_URL=https://vellumstudy.vercel.app
# Google Search Console HTML Meta Tag verification token
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code (msvalidate.01)
VITE_BING_SITE_VERIFICATION=
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Google Tag Manager Container ID (e.g., GTM-XXXXXXX)
VITE_GTM_ID=
